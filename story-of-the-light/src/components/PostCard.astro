---
import type { MainTab, Post } from '@types';
import CharacterBadge from './CharacterBadge.astro';
import { url } from '@lib/url';

interface Props { post: Post; tab: MainTab; index?: number }
const { post, tab, index = 0 } = Astro.props;

const edge = tab.kind === 'dual' ? 'dual-edge' : 'single-edge';
const delay = `${Math.min(index, 8) * 45}ms`;
---

<article class={`card panel ${edge}`} style={`animation-delay:${delay}`}>
  <a href={url(`post/${post.id}`)}>
    {post.cover && <img class="card__cover" src={post.cover} alt="" loading="lazy" />}
    <div class="card__body">
      {(post.date || post.tags.length > 0) && (
        <p class="card__meta">
          {post.date && <time datetime={post.date}>{post.date}</time>}
          {post.date && post.tags.length > 0 && <span aria-hidden="true">◆</span>}
          {post.tags[0] && <span>{post.tags[0]}</span>}
        </p>
      )}
      <h2 class="card__title">{post.title}</h2>
      {post.summary && <p class="card__summary">{post.summary}</p>}
      {post.characters.length > 0 && (
        <p class="card__foot">
          {post.characters.map((name) => <CharacterBadge name={name} />)}
        </p>
      )}
    </div>
  </a>
</article>
