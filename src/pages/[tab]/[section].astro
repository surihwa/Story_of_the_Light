---
import type { GetStaticPaths } from 'astro';
import SectionView from '@components/SectionView.astro';
import { contentTabs, subTabs } from '@config/tabs';
import type { MainTab, SectionId } from '@types';

/** 각 분류의 첫 쪽. Logs 2쪽부터는 [section]/[page].astro 가 맡습니다. */
export const getStaticPaths: GetStaticPaths = () =>
  contentTabs.flatMap((tab) =>
    subTabs.map((sub) => ({
      params: { tab: tab.id, section: sub.id },
      props: { tab, section: sub.id },
    })),
  );

const { tab, section } = Astro.props as { tab: MainTab; section: SectionId };
---

<SectionView tab={tab} section={section} page={1} />
