---
import BaseLayout from '@layouts/BaseLayout.astro';
import EmptyState from '@components/EmptyState.astro';
import { url } from '@lib/url';
---

<BaseLayout title="찾을 수 없는 쪽">
  <div style="padding-block:3rem 4rem">
    <EmptyState
      title="이 주소에는 아무것도 없습니다"
      hint="주소가 바뀌었거나, 글이 아직 공개되지 않았을 수 있습니다."
    />
    <p style="text-align:center;margin-top:1.5rem">
      <a href={url()} style="font-family:var(--font-mono);color:var(--accent)">첫 화면으로 →</a>
    </p>
  </div>
</BaseLayout>
