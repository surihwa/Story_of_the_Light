---
import type { MainTab, Post } from '@types';

interface Props { post: Post; tab: MainTab }
const { post, tab } = Astro.props;

/**
 * 제목 없이 본문만 보여 줍니다.
 * 10줄이 넘으면 접어 두고, 페이지를 떠나지 않고 그 자리에서 펼칩니다.
 *
 * 펼치기는 체크박스로 처리해서 자바스크립트 없이도 동작합니다.
 * 스크립트는 '실제로 잘린 카드에만 버튼을 남기는' 역할만 합니다.
 */
const edge = tab.kind === 'dual' ? 'dual-edge' : 'single-edge';
const toggleId = `log-${post.id}`;
---

<article class={`log-card panel ${edge}`}>
  <input type="checkbox" id={toggleId} class="log-card__toggle" />
  {post.numberLabel && <p class="log-card__no">{post.numberLabel}</p>}

  <div class="log-card__clip" data-log-clip>
    <div class="log-card__body prose" set:html={post.html} />
  </div>

  <label class="log-card__more" for={toggleId}>
    <span class="log-card__more-open">더보기</span>
    <span class="log-card__more-close">접기</span>
  </label>
</article>

<script>
  /**
   * 열 줄에 못 미치는 카드에는 '더보기'가 필요 없습니다.
   * 스크립트가 실패해도 버튼은 그대로 남아 동작하므로, 잃는 것은 없습니다.
   */
  const measure = () => {
    document.querySelectorAll<HTMLElement>('[data-log-clip]').forEach((clip) => {
      const card = clip.closest('.log-card');
      const toggle = card?.querySelector<HTMLInputElement>('.log-card__toggle');
      if (!card || !toggle || toggle.checked) return; // 펼쳐진 카드는 건드리지 않습니다
      card.classList.toggle('is-clipped', clip.scrollHeight - clip.clientHeight > 2);
    });
  };

  measure();
  window.addEventListener('resize', measure);
  document.fonts?.ready.then(measure);

  /**
   * 다단 레이아웃이라 카드를 펼치면 내용이 열 사이로 재배치됩니다.
   * 그대로 두면 방금 펼친 카드가 다른 열로 밀려 화면 밖으로 사라집니다.
   * 펼치기 전후의 위치 차이만큼 스크롤을 옮겨, 읽던 자리를 붙잡아 둡니다.
   */
  document.addEventListener('change', (event) => {
    const toggle = event.target;
    if (!(toggle instanceof HTMLInputElement) || !toggle.classList.contains('log-card__toggle')) return;

    const card = toggle.closest('.log-card');
    if (!card) return;

    const before = card.getBoundingClientRect().top;
    requestAnimationFrame(() => {
      const after = card.getBoundingClientRect().top;
      const delta = after - before;
      if (Math.abs(delta) > 1) window.scrollBy({ top: delta, behavior: 'instant' });
    });
  });
</script>
