---
import type { MainTab, Post } from '@types';

interface Props { post: Post; tab: MainTab }
const { post, tab } = Astro.props;

/** 제목 없이 본문만, 길이에 관계없이 전문을 그대로 보여 줍니다. */
const edge = tab.kind === 'dual' ? 'dual-edge' : 'single-edge';
---

<article class={`log-card panel ${edge}`}>
  {post.numberLabel && <p class="log-card__no">{post.numberLabel}</p>}
  <div class="log-card__body prose" set:html={post.html} />
</article>
