---
import BaseLayout from '@layouts/BaseLayout.astro';
import SubNav from '@components/SubNav.astro';
import PostCard from '@components/PostCard.astro';
import LogCard from '@components/LogCard.astro';
import ProfileCard from '@components/ProfileCard.astro';
import EmptyState from '@components/EmptyState.astro';
import Pagination from '@components/Pagination.astro';
import { getSubTab, getGroup } from '@config/tabs';
import { LOGS_PER_PAGE } from '@config/sources';
import { getPosts } from '@lib/content';
import { filterPosts } from '@lib/filters';
import type { MainTab, SectionId } from '@types';

interface Props {
  tab: MainTab;
  section: SectionId;
  /** Logs 에서만 의미가 있습니다. 다른 분류는 항상 1쪽입니다. */
  page?: number;
}
const { tab, section, page = 1 } = Astro.props;

const sub = getSubTab(section)!;
const group = getGroup(tab.group);

const allPosts = filterPosts(await getPosts(), tab, section);
const count = allPosts.length;

/** Logs 만 쪽을 나눕니다. */
const paginated = section === 'logs';
const totalPages = paginated ? Math.max(1, Math.ceil(count / LOGS_PER_PAGE)) : 1;
const posts = paginated
  ? allPosts.slice((page - 1) * LOGS_PER_PAGE, page * LOGS_PER_PAGE)
  : allPosts;

/** 세계 + Profile 은 모든 캐릭터의 프로필을 한데 모으는 예외 화면입니다. */
const isAllProfiles = tab.kind === 'world' && section === 'profile';

const title = page > 1
  ? `${tab.label} · ${sub.label} (${page}쪽)`
  : `${tab.label} · ${sub.label}`;
---

<BaseLayout title={title} activeTab={tab.id}>
  <SubNav tabId={tab.id} active={section} />

  <header class="page-head">
    {group && <p class="page-head__group">{group.label}</p>}
    <h1 class="page-head__title">{isAllProfiles ? '모든 캐릭터 프로필' : tab.label}</h1>
    <p class="page-head__count">
      {count} entries{totalPages > 1 && ` · ${page} / ${totalPages}`}
    </p>
  </header>

  {count === 0 ? (
    <div style="padding-block:1.5rem 3rem"><EmptyState /></div>
  ) : section === 'profile' ? (
    <div class="grid grid--wide">
      {posts.map((post) => <ProfileCard post={post} />)}
    </div>
  ) : section === 'logs' ? (
    <>
      <div class="log-list">
        {posts.map((post) => <LogCard post={post} tab={tab} />)}
      </div>
      <Pagination current={page} total={totalPages} base={`${tab.id}/${section}`} />
    </>
  ) : (
    <div class="grid">
      {posts.map((post, i) => <PostCard post={post} tab={tab} index={i} />)}
    </div>
  )}
</BaseLayout>
