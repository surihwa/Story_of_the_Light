---
import type { Post } from '@types';
import { url } from '@lib/url';

interface Props { posts: Post[] }
const { posts } = Astro.props;

/** 한 행에 여러 장이 붙어 있어도 모두 펼쳐서 한 그리드에 늘어놓습니다. */
const items = posts.flatMap((post) =>
  post.images.map((image, i) => ({
    ...image,
    postId: post.id,
    label: post.numberLabel && post.images.length > 1
      ? `${post.numberLabel}-${i + 1}`
      : post.numberLabel,
  })),
);
---

<div class="media">
  {items.map((item) => (
    <figure class="media__item">
      <a href={url(`post/${item.postId}`)}>
        <img src={item.src} alt={item.alt || item.label || ''} loading="lazy" />
      </a>
      {(item.caption || item.label) && (
        <figcaption class="media__cap">{item.caption || item.label}</figcaption>
      )}
    </figure>
  ))}
</div>
