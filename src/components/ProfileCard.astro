---
import type { Post } from '@types';
import { getCharacter } from '@config/characters';
import { excerpt } from '@lib/blocks';
import { colorVars } from '@lib/theme';
import { url } from '@lib/url';

interface Props { post: Post }
const { post } = Astro.props;

const name = post.characters[0] ?? post.title;
const character = getCharacter(name);
const color = character?.color ?? '#64748B';
const preview = excerpt(post.text, 150);
---

<article class="profile panel" style={`${colorVars(color)};border-left:3px solid ${color}`}>
  {post.cover
    ? <img class="profile__portrait" src={post.cover} alt={`${name} 초상`} loading="lazy" />
    : <div class="profile__portrait--empty" aria-hidden="true">{name.slice(0, 1)}</div>}

  <div class="profile__body">
    {character?.role && <p class="profile__role">{character.role}</p>}
    <h2 class="profile__name">{character?.name ?? name}</h2>
    {preview && <p class="profile__preview">{preview}</p>}
    <p class="profile__link">
      <a href={url(`post/${post.id}`)} style={`color:${color}`}>자세히 보기 →</a>
    </p>
  </div>
</article>
