---
import { site } from '@config/site';
import { themeVars } from '@lib/theme';
import { getTab } from '@config/tabs';
import Header from '@components/Header.astro';
import MainNav from '@components/MainNav.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import '@styles/theme.css';
import '@styles/components.css';

interface Props {
  title?: string;
  description?: string;
  /** 현재 활성 메인 탭 슬러그. 전달하면 강조색이 이 탭 기준으로 바뀝니다. */
  activeTab?: string;
}

const { title, description = site.description, activeTab } = Astro.props;
const tab = activeTab ? getTab(activeTab) : undefined;
const vars = tab ? themeVars(tab) : '';
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} — ${site.subtitle}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Marcellus&family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+KR:wght@300;400;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body style={vars}>
    <a class="sr-only" href="#main">본문으로 건너뛰기</a>
    <Header />
    <MainNav active={activeTab} />
    <main id="main" class="shell">
      <slot />
    </main>
    <Footer />
  </body>
</html>
